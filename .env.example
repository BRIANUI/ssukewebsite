# Firebase (required) — from Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# After filling in values above:
# 1. Enable Firestore Database and Storage in Firebase Console
# 2. Enable Email/Password sign-in (Authentication → Sign-in method)
# 3. Create an admin user (Authentication → Users → Add user)
# 4. Deploy rules: firebase deploy --only firestore:rules,storage
